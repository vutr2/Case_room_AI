# Copy to services/rag/.env for `uv run uvicorn ...` on your machine.
# Start the databases first, in this folder: docker compose up -d --wait

# Required, at least 32 characters: openssl rand -hex 32
# The web app will send the same value (RAG_SERVICE_TOKEN in the root .env).
RAG_SERVICE_TOKEN=""

# PostgreSQL with pgvector (port 5433; not the web app's database).
RAG_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/case_room_rag"

# Neo4j for the entity graph (browser: http://localhost:7474).
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="case-room-dev"
